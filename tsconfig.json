{
  "extends": ["@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "#/*": ["*"]
    }
  }
}
